    <string name="quote_1" formatted="false">De petits pas chaque jour finissent par produire de grands changements.</string>
    <string name="quote_10" formatted="false">Ton avenir se construit avec les habitudes d\'aujourd\'hui.</string>
    <string name="quote_2" formatted="false">Commence là où tu es, avec ce que tu as, fais ce que tu peux.</string>
    <string name="quote_3" formatted="false">Vise le progrès, pas la perfection.</string>
    <string name="quote_4" formatted="false">Le repos fait partie du travail, il n\'en est pas une pause.</string>
    <string name="quote_5" formatted="false">Aujourd\'hui est une page blanche. Écris-y quelque chose dont tu seras fier.</string>
    <string name="quote_6" formatted="false">Ce que tu fais chaque jour compte plus que ce que tu fais de temps en temps.</string>
    <string name="quote_7" formatted="false">Sois patient avec toi-même ; grandir prend du temps.</string>
    <string name="quote_8" formatted="false">Une tâche terminée vaut mieux que dix plans parfaits.</string>
    <string name="quote_9" formatted="false">La gentillesse ne coûte rien et change tout.</string>
