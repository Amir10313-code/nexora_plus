    <string name="quote_1" formatted="false">Small steps taken every day add up to big changes.</string>
    <string name="quote_10" formatted="false">Your future is built by the habits of today.</string>
    <string name="quote_2" formatted="false">Start where you are, use what you have, do what you can.</string>
    <string name="quote_3" formatted="false">Focus on progress, not perfection.</string>
    <string name="quote_4" formatted="false">Rest is part of the work, not a break from it.</string>
    <string name="quote_5" formatted="false">Today is a fresh page. Write something you are proud of.</string>
    <string name="quote_6" formatted="false">What you do every day matters more than what you do once in a while.</string>
    <string name="quote_7" formatted="false">Be patient with yourself; growth takes time.</string>
    <string name="quote_8" formatted="false">One finished task is worth more than ten perfect plans.</string>
    <string name="quote_9" formatted="false">Kindness costs nothing and changes everything.</string>
