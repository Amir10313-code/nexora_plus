    <string name="quote_1" formatted="false">Piccoli passi ogni giorno si sommano in grandi cambiamenti.</string>
    <string name="quote_10" formatted="false">Il tuo futuro si costruisce con le abitudini di oggi.</string>
    <string name="quote_2" formatted="false">Comincia da dove sei, usa ciò che hai, fai ciò che puoi.</string>
    <string name="quote_3" formatted="false">Punta al progresso, non alla perfezione.</string>
    <string name="quote_4" formatted="false">Il riposo fa parte del lavoro, non è una pausa da esso.</string>
    <string name="quote_5" formatted="false">Oggi è una pagina nuova. Scrivi qualcosa di cui andare fiero.</string>
    <string name="quote_6" formatted="false">Ciò che fai ogni giorno conta più di ciò che fai ogni tanto.</string>
    <string name="quote_7" formatted="false">Sii paziente con te stesso: crescere richiede tempo.</string>
    <string name="quote_8" formatted="false">Un\'attività conclusa vale più di dieci piani perfetti.</string>
    <string name="quote_9" formatted="false">La gentilezza non costa nulla e cambia tutto.</string>
